# Conexão com o Postgres local (container postgres17, porta 5432).
# Variáveis lidas por servers/src/main/resources/spring/conf/jdbc.properties
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
# Senha padrão do servers/pom.xml; não foi verificada contra o container.
DB_PASS=
# Redireciona todo e-mail da aplicação durante os testes
MAIL_REDIRECT_TO=
MAIL_HOST=
MAIL_PORT=
MAIL_STARTTLS=
MAIL_SSL=
